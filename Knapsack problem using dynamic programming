#include <iostream>
using namespace std;

int max(int a, int b)
{
    return (a > b) ? a : b;
}

int knapsack(int W, int wt[], int val[], int n)
{
    int dp[n + 1][W + 1];

    // Build DP table
    for (int i = 0; i <= n; i++)
    {
        for (int w = 0; w <= W; w++)
        {
            // If no item or capacity is 0
            if (i == 0 || w == 0)
                dp[i][w] = 0;

            // If item weight is less than or equal to capacity
            else if (wt[i - 1] <= w)
                dp[i][w] = max(
                    val[i - 1] + dp[i - 1][w - wt[i - 1]],
                    dp[i - 1][w]
                );

            // If item cannot be included
            else
                dp[i][w] = dp[i - 1][w];
        }
    }

    return dp[n][W];
}

int main()
{
    int n = 4;
    int W = 7;

    int wt[] = {1, 3, 4, 5};
    int val[] = {1, 4, 5, 7};

    int result = knapsack(W, wt, val, n);

    cout << "Maximum Profit = " << result << endl;

    return 0;
}
